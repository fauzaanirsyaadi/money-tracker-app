        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:label="Money Tracker UI driver"
        android:targetPackage="io.github.fauzaanirsyaadi.moneytracker.uia" />

    <application
        android:allowBackup="false"
        android:label="mt-uia"
        android:usesCleartextTraffic="false" />
</manifest>
