<?xml version="1.0" encoding="utf-8"?>
<!--
  Money Tracker keeps all data on the device. Nothing may leave it through the
  system: no cloud backup and no device-to-device transfer. The only way out is
  the encrypted backup file the user chooses to export.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
